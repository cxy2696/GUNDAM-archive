{
  "name": "gundam-archive",
  "version": "1.1.0",
  "private": true,
  "description": "GUNDAM Archive — a traceable, bilingual mobile-suit knowledge archive.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "python3 -m http.server 4173 --directory out",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run docs:check && npm run typecheck && npm run build",
    "postbuild": "node scripts/build-404.mjs",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cxy2696/GUNDAM-archive.git"
  }
