{
  "name": "gundam-archive",
  "version": "3.1.1",
  "private": true,
  "description": "GUNDAM Archive — an interactive, traceable mobile-suit archive with a 12-era 2D/3D atlas, 3D relationship graphs, bilingual content and static export.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "python3 -m http.server 4173 --directory out",
    "validate": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate && npm run docs:check && npm run typecheck && npm run language:check && npm run build && npm run links:check && npm run routes:check",
    "postbuild": "node scripts/build-404.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "language:check": "node scripts/check-language.mjs",
    "links:check": "node scripts/check-links.mjs",
    "prebuild": "tsx scripts/build-search-index.ts",
    "predev": "tsx scripts/build-search-index.ts",
    "routes:check": "node scripts/check-routes.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cxy2696/GUNDAM-archive.git"
  }
}
